# ── 3. 从 DICOM 获取真实像素间距（mm）────────────────────────────────
def get_pixel_spacing_mm(ds):
    """返回 (row_spacing_mm, col_spacing_mm, source)。

    优先使用标准 DICOM PixelSpacing / ImagerPixelSpacing。
    对超声 DICOM，如果标准 PixelSpacing 缺失，则尝试
    SequenceOfUltrasoundRegions 中的 PhysicalDeltaX/Y。

    DICOM 超声区域标定中，PhysicalUnits*=3 表示 cm，因此转换为 mm。
    如果无法获得可靠空间标定，直接报错，不默认假定 1×1 mm。
    """
    for attr in ('PixelSpacing', 'ImagerPixelSpacing', 'NominalScannedPixelSpacing'):
        value = getattr(ds, attr, None)
        if value is not None and len(value) >= 2:
            row = abs(float(value[0]))
            col = abs(float(value[1]))
            if row > 0 and col > 0:
                return row, col, attr

    regions = getattr(ds, 'SequenceOfUltrasoundRegions', None)
    if regions:
        for region in regions:
            dx = getattr(region, 'PhysicalDeltaX', None)  # x = column direction
            dy = getattr(region, 'PhysicalDeltaY', None)  # y = row direction
            ux = getattr(region, 'PhysicalUnitsXDirection', None)
            uy = getattr(region, 'PhysicalUnitsYDirection', None)

            if dx is None or dy is None or ux is None or uy is None:
                continue

            dx = abs(float(dx))
            dy = abs(float(dy))
            if dx <= 0 or dy <= 0:
                continue

            # DICOM US Region Calibration: 3 = cm
            if int(ux) == 3 and int(uy) == 3:
                col_mm = dx * 10.0
                row_mm = dy * 10.0
                return row_mm, col_mm, 'SequenceOfUltrasoundRegions'

    raise ValueError(
        'DICOM 中未找到可靠的物理像素间距。请检查 PixelSpacing / '
        'ImagerPixelSpacing / SequenceOfUltrasoundRegions(PhysicalDeltaX/Y)，'
        '不要直接假定原始图像已经是 1×1 mm。'
    )


# ── 4. 图像和 ROI 统一重采样到 1×1 mm ───────────────────────────────
def resample_image_and_mask(image, mask, spacing_mm,
                            target_spacing_mm=TARGET_SPACING_MM):
    """空间重采样。

    灰度图像：SimpleITK B-spline interpolation
    ROI mask：nearest-neighbor interpolation

    参数中的 spacing 顺序为 (row, col)，单位 mm。
    """
    row_spacing, col_spacing = spacing_mm
    target_row, target_col = target_spacing_mm

    # SimpleITK 的空间顺序是 (x, y) = (column, row)
    old_spacing_xy = (float(col_spacing), float(row_spacing))
    new_spacing_xy = (float(target_col), float(target_row))

    img_sitk = sitk.GetImageFromArray(image.astype(np.float32))
    img_sitk.SetSpacing(old_spacing_xy)

    mask_sitk = sitk.GetImageFromArray(mask.astype(np.uint8))
    mask_sitk.SetSpacing(old_spacing_xy)

    old_size = img_sitk.GetSize()
    new_size = [
        max(1, int(round(old_size[i] * old_spacing_xy[i] / new_spacing_xy[i])))
        for i in range(2)
    ]

    # 灰度图：B-spline
    img_resampler = sitk.ResampleImageFilter()
    img_resampler.SetOutputSpacing(new_spacing_xy)
    img_resampler.SetSize(new_size)
    img_resampler.SetOutputOrigin(img_sitk.GetOrigin())
    img_resampler.SetOutputDirection(img_sitk.GetDirection())
    img_resampler.SetInterpolator(sitk.sitkBSpline)
    img_resampler.SetDefaultPixelValue(float(np.min(image)))
    image_r = sitk.GetArrayFromImage(img_resampler.Execute(img_sitk)).astype(np.float32)

    # ROI：nearest-neighbor，避免边界出现非 0/1 中间值
    mask_resampler = sitk.ResampleImageFilter()
    mask_resampler.SetOutputSpacing(new_spacing_xy)
    mask_resampler.SetSize(new_size)
    mask_resampler.SetOutputOrigin(mask_sitk.GetOrigin())
    mask_resampler.SetOutputDirection(mask_sitk.GetDirection())
    mask_resampler.SetInterpolator(sitk.sitkNearestNeighbor)
    mask_resampler.SetDefaultPixelValue(0)
    mask_r = sitk.GetArrayFromImage(mask_resampler.Execute(mask_sitk)) > 0

    if image_r.shape != mask_r.shape:
        raise RuntimeError(
            f'重采样后图像与 ROI 尺寸不一致：{image_r.shape} vs {mask_r.shape}'
        )

    return image_r, mask_r


def normalize_to_uint8(image):
    """保留原程序的 0-255 预处理逻辑；ITH 内部随后仍进行 ROI 内 Z-score。"""
    img_min = float(np.min(image))
    img_max = float(np.max(image))
    if img_max > img_min:
        return ((image - img_min) / (img_max - img_min) * 255).astype(np.uint8)
    return np.zeros_like(image, dtype=np.uint8)


# ── 5. 加载 DICOM + NRRD，并在 ITH 计算前重采样 ─────────────────────
def load_dicom_and_nrrd_mask(image_path: Path, mask_path: Path):
    """加载 DICOM 原始影像 + seg.nrrd 掩膜，并统一重采样至 1×1 mm。"""
    ds = pydicom.dcmread(str(image_path))
    img_arr = ds.pixel_array.astype(np.float32)

    # 应用 DICOM rescale（超声通常为默认 1/0；若存在则按标签执行）
    slope = float(getattr(ds, 'RescaleSlope', 1))
    intercept = float(getattr(ds, 'RescaleIntercept', 0))
    img_arr = img_arr * slope + intercept

    # 保留原程序逻辑。若研究实际使用特定“最大切面”帧，建议显式读取该帧。
    if img_arr.ndim == 3:
        img_arr = img_arr[img_arr.shape[0] // 2]

    if img_arr.ndim != 2:
        raise ValueError(f'当前脚本仅支持 2-D ITH 图像，实际维度为 {img_arr.shape}')

    row_spacing, col_spacing, spacing_source = get_pixel_spacing_mm(ds)

    # 读取 seg.nrrd 掩膜
    msk_data, _ = nrrd.read(str(mask_path))
    msk_data = np.squeeze(msk_data)
    if msk_data.ndim == 2:
        msk_data = msk_data.T
    mask = msk_data > 0

    if mask.shape != img_arr.shape:
        raise ValueError(
            f'重采样前图像尺寸 {img_arr.shape} 与掩膜尺寸 {mask.shape} 不匹配：\n'
            f'  {image_path.name} / {mask_path.name}'
        )

    # ★ 核心新增：在 K-means / connected-component / ITH 之前统一到 1×1 mm
    img_r, mask_r = resample_image_and_mask(
        img_arr,
        mask,
        spacing_mm=(row_spacing, col_spacing),
        target_spacing_mm=TARGET_SPACING_MM
    )

    # 为尽量保持旧版计算逻辑：重采样后再做 0-255，再在 compute_ith_score 内 Z-score
    gray_r = normalize_to_uint8(img_r)

    spacing_info = {
        'original_row_spacing_mm': row_spacing,
        'original_col_spacing_mm': col_spacing,
        'spacing_source': spacing_source,
        'target_row_spacing_mm': TARGET_SPACING_MM[0],
        'target_col_spacing_mm': TARGET_SPACING_MM[1],
        'original_shape': tuple(img_arr.shape),
        'resampled_shape': tuple(gray_r.shape),
    }

    return gray_r, mask_r, spacing_info


# ── 6. 核心 ITH 计算逻辑（与原版保持一致）───────────────────────────
def compute_ith_score(gray, mask, v=V):
    pixels = gray[mask].astype(np.float32).reshape(-1, 1)
    s_total = len(pixels)
    if s_total == 0:
        raise ValueError('ROI 为空，无法计算 ITH。')

    pixels_zscore = (pixels - pixels.mean()) / (pixels.std() + 1e-8)

    km = MiniBatchKMeans(n_clusters=v, random_state=42, n_init=10, batch_size=1024)
    labels = km.fit_predict(pixels_zscore)

    centers = km.cluster_centers_.flatten()
    order = np.argsort(centers)
    remap = {old: new for new, old in enumerate(order)}
    sorted_labels = np.array([remap[c] for c in labels])

    cluster_map = np.full(gray.shape, -1, dtype=int)
    cluster_map[mask] = sorted_labels

    score_sum = 0.0
    for i in range(v):
        c_mask = (cluster_map == i).astype(np.uint8)
        labeled = label(c_mask)
        regions = regionprops(labeled)
        if regions:
            n_i = len(regions)
            s_max = max(r.area for r in regions)
            score_sum += (s_max / n_i)

    ith = 1.0 - (score_sum / s_total)
    return float(np.clip(ith, 0, 1)), cluster_map


# ── 7. 可视化（基本沿用原版）────────────────────────────────────────
def save_nejm_figure(gray, mask, cluster_map, ith_val, case_name,
                     figure_dir, panel_label_start='A'):
    labels = [panel_label_start, chr(ord(panel_label_start) + 1)]
    fig = plt.figure(figsize=(DOUBLE_COL, DOUBLE_COL * 0.46), facecolor='white')
    gs = gridspec.GridSpec(1, 2, figure=fig,
                           left=0.04, right=0.96, top=0.88, bottom=0.08, wspace=0.12)

    ax_orig = fig.add_subplot(gs[0])
    ax_orig.imshow(gray, cmap='gray', interpolation='lanczos', vmin=0, vmax=255)
    contours = measure.find_contours(mask.astype(float), 0.5)
    for c in contours:
        ax_orig.plot(c[:, 1], c[:, 0], color='white', linewidth=0.8)
    ax_orig.set_axis_off()
    ax_orig.text(0.02, 0.97, labels[0], transform=ax_orig.transAxes,
                 fontsize=11, fontweight='bold', color='white', va='top')

    ax_clus = fig.add_subplot(gs[1])
    ax_clus.set_facecolor('black')
    ax_clus.imshow(np.zeros_like(gray), cmap='gray', vmin=0, vmax=255)
    display_map = np.ma.masked_where(cluster_map == -1, cluster_map)
    ax_clus.imshow(display_map, cmap=CLUSTER_CMAP, vmin=0, vmax=V - 1, interpolation='none')
    for c in contours:
        ax_clus.plot(c[:, 1], c[:, 0], color='white', linewidth=0.8)
    ax_clus.set_axis_off()
    ax_clus.text(0.02, 0.97, labels[1], transform=ax_clus.transAxes,
                 fontsize=11, fontweight='bold', color='white', va='top')

    legend_patches = [
        mpatches.Patch(facecolor=CLUSTER_COLORS[i], label=f'Cluster {i+1}')
        for i in range(V)
    ]
    leg = ax_clus.legend(handles=legend_patches, loc='lower right',
                         framealpha=0.85, facecolor='black', fontsize=7)
    for text in leg.get_texts():
        text.set_color('white')

    ax_clus.text(0.02, 0.03, f'ITH Score = {ith_val:.3f}',
                 transform=ax_clus.transAxes, fontsize=8, color='white',
                 bbox=dict(boxstyle='round', facecolor='black', alpha=0.6))

    out_path = figure_dir / f'{case_name}_NEJM.tiff'
    fig.savefig(out_path, dpi=300, format='tiff', bbox_inches='tight')
    plt.close(fig)


# ── 8. 批量执行 ──────────────────────────────────────────────────────
image_files = sorted(BASE_DIR.glob('*.dcm'))

records = []
for img_path in tqdm(image_files):
    case_id = img_path.stem
    mask_path = BASE_DIR / f'{case_id}mask.seg.nrrd'

    if not mask_path.exists():
        print(f'⚠️  找不到掩膜：{mask_path.name}，跳过')
        continue

    try:
        gray, mask, spacing_info = load_dicom_and_nrrd_mask(img_path, mask_path)
        ith_val, cluster_map = compute_ith_score(gray, mask)

        records.append({
            '病例名称': case_id,
            'ITH评分': round(ith_val, 6),
            # 目标 spacing = 1×1 mm，因此重采样后像素数约等于 ROI 面积(mm²)
            'ROI面积_mm2': int(mask.sum()),
            '原始RowSpacing_mm': round(spacing_info['original_row_spacing_mm'], 6),
            '原始ColSpacing_mm': round(spacing_info['original_col_spacing_mm'], 6),
            'Spacing来源': spacing_info['spacing_source'],
            '重采样后行数': spacing_info['resampled_shape'][0],
            '重采样后列数': spacing_info['resampled_shape'][1],
        })

        save_nejm_figure(gray, mask, cluster_map, ith_val, case_id, FIGURE_DIR)

    except Exception as e:
        print(f'❌ {case_id} 失败: {e}')

if records:
    pd.DataFrame(records).to_csv(OUTPUT_CSV, index=False, encoding='utf-8-sig')
    print(f'\n🎉 处理完成！结果已保存至：{OUTPUT_CSV}')

