import numpy as np
import pandas as pd
import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt
import matplotlib.gridspec as gridspec
from matplotlib.colors import ListedColormap
import matplotlib.patches as mpatches
from skimage import measure
import pydicom                          
import nrrd                             
from pathlib import Path
from sklearn.cluster import MiniBatchKMeans
from skimage.measure import label, regionprops
from tqdm import tqdm
import warnings

warnings.filterwarnings('ignore')

# ── 1. 路径与基础配置 ────────────────────────────────────────────────
BASE_DIR   = Path(r'D:\dicomoutput\traindcm')
V          = 5
OUTPUT_CSV = BASE_DIR / 'ITH_分析结果.csv'
FIGURE_DIR = BASE_DIR / '可视化结果_NEJM'
FIGURE_DIR.mkdir(exist_ok=True)

# ── 2. NEJM 全局绘图参数 ─────────────────────────────────────────────
NEJM_PARAMS = {
    'font.family':       'Arial',
    'font.size':         9,
    'axes.titlesize':    10,
    'axes.labelsize':    9,
    'xtick.labelsize':   8,
    'ytick.labelsize':   8,
    'legend.fontsize':   8,
    'figure.dpi':        300,
    'savefig.dpi':       300,
    'axes.linewidth':    0.8,
    'xtick.major.width': 0.8,
    'ytick.major.width': 0.8,
    'lines.linewidth':   1.0,
    'pdf.fonttype':      42,
    'ps.fonttype':       42,
}
plt.rcParams.update(NEJM_PARAMS)

CLUSTER_COLORS = ['#0072B2', '#56B4E9', '#E69F00', '#D55E00', '#009E73']
CLUSTER_CMAP   = ListedColormap(CLUSTER_COLORS)
CM             = 1 / 2.54
DOUBLE_COL     = 17.8 * CM

# ── 3. 💡 修改点 2: 混合加载函数（DICOM图像 + NRRD掩膜）──────────────
def load_dicom_and_nrrd_mask(image_path: Path, mask_path: Path):
    """
    加载 DICOM 原始影像 + seg.nrrd 掩膜。

    返回
    ----
    gray : np.ndarray (uint8, 2-D)  — 归一化至 0-255 的灰度图
    mask : np.ndarray (bool, 2-D)   — ROI 布尔掩膜
    """
    # ── 读取 DICOM 影像 ───────────────────────────────────────────
    ds       = pydicom.dcmread(str(image_path))
    img_arr  = ds.pixel_array.astype(np.float32)

    # 应用 RescaleSlope / RescaleIntercept（CT 转 HU 值）
    slope     = float(getattr(ds, 'RescaleSlope',     1))
    intercept = float(getattr(ds, 'RescaleIntercept', 0))
    img_arr   = img_arr * slope + intercept

    # 三维体积取中间层
    if img_arr.ndim == 3:
        img_arr = img_arr[img_arr.shape[0] // 2]

    # 归一化到 0-255（用于可视化；ITH 内部会 Z-score）
    img_min, img_max = img_arr.min(), img_arr.max()
    if img_max > img_min:
        gray = ((img_arr - img_min) / (img_max - img_min) * 255).astype(np.uint8)
    else:
        gray = img_arr.astype(np.uint8)

    # ── 读取 seg.nrrd 掩膜（逻辑与原版相同）─────────────────────
    msk_data, _ = nrrd.read(str(mask_path))
    msk_data    = np.squeeze(msk_data)
    if msk_data.ndim == 2:
        msk_data = msk_data.T

    mask = msk_data > 0

    # 尺寸校验
    if mask.shape != gray.shape:
        raise ValueError(
            f"图像尺寸 {gray.shape} 与掩膜尺寸 {mask.shape} 不匹配：\n"
            f"  {image_path.name} / {mask_path.name}"
        )

    return gray, mask


# ── 4. 核心计算逻辑（与原版完全相同）────────────────────────────────
def compute_ith_score(gray, mask, v=V):
    pixels        = gray[mask].astype(np.float32).reshape(-1, 1)
    s_total       = len(pixels)
    pixels_zscore = (pixels - pixels.mean()) / (pixels.std() + 1e-8)

    km     = MiniBatchKMeans(n_clusters=v, random_state=42, n_init=10, batch_size=1024)
    labels = km.fit_predict(pixels_zscore)

    centers = km.cluster_centers_.flatten()
    order   = np.argsort(centers)
    remap   = {old: new for new, old in enumerate(order)}
    sorted_labels = np.array([remap[c] for c in labels])

    cluster_map = np.full(gray.shape, -1, dtype=int)
    cluster_map[mask] = sorted_labels

    score_sum = 0.0
    for i in range(v):
        c_mask  = (cluster_map == i).astype(np.uint8)
        labeled = label(c_mask)
        regions = regionprops(labeled)
        if regions:
            n_i   = len(regions)
            s_max = max([r.area for r in regions])
            score_sum += (s_max / n_i)

    ith = 1.0 - (score_sum / s_total)
    return float(np.clip(ith, 0, 1)), cluster_map


# ── 5. 可视化（与原版完全相同）──────────────────────────────────────
def save_nejm_figure(gray, mask, cluster_map, ith_val, case_name,
                     figure_dir, panel_label_start='A'):
    labels = [panel_label_start, chr(ord(panel_label_start) + 1)]
    fig = plt.figure(figsize=(DOUBLE_COL, DOUBLE_COL * 0.46), facecolor='white')
    gs  = gridspec.GridSpec(1, 2, figure=fig,
                            left=0.04, right=0.96, top=0.88, bottom=0.08, wspace=0.12)

    ax_orig = fig.add_subplot(gs[0])
    ax_orig.imshow(gray, cmap='gray', interpolation='lanczos', vmin=0, vmax=255)
    contours = measure.find_contours(mask.astype(float), 0.5)
    for c in contours:
        ax_orig.plot(c[:, 1], c[:, 0], color='white', linewidth=0.8)
    ax_orig.set_axis_off()
    ax_orig.text(0.02, 0.97, labels[0], transform=ax_orig.transAxes,
                 fontsize=11, fontweight='bold', color='white', va='top')

    ax_clus = fig.add_subplot(gs[1])
    ax_clus.set_facecolor('black')
    ax_clus.imshow(np.zeros_like(gray), cmap='gray', vmin=0, vmax=255)
    display_map = np.ma.masked_where(cluster_map == -1, cluster_map)
    ax_clus.imshow(display_map, cmap=CLUSTER_CMAP, vmin=0, vmax=V - 1, interpolation='none')
    for c in contours:
        ax_clus.plot(c[:, 1], c[:, 0], color='white', linewidth=0.8)
    ax_clus.set_axis_off()
    ax_clus.text(0.02, 0.97, labels[1], transform=ax_clus.transAxes,
                 fontsize=11, fontweight='bold', color='white', va='top')

    legend_patches = [mpatches.Patch(facecolor=CLUSTER_COLORS[i], label=f'Cluster {i+1}')
                      for i in range(V)]
    leg = ax_clus.legend(handles=legend_patches, loc='lower right',
                         framealpha=0.85, facecolor='black', fontsize=7)
    for text in leg.get_texts():
        text.set_color('white')

    ax_clus.text(0.02, 0.03, f'ITH Score = {ith_val:.3f}',
                 transform=ax_clus.transAxes, fontsize=8, color='white',
                 bbox=dict(boxstyle='round', facecolor='black', alpha=0.6))

    out_path = figure_dir / f"{case_name}_NEJM.tiff"
    fig.savefig(out_path, dpi=300, format='tiff', bbox_inches='tight')
    plt.close(fig)


# ── 6. 💡 修改点 3: 批量执行（影像匹配规则改为 .dcm）────────────────
#
#  命名约定：
#    原始影像：  {case_id}.dcm              示例：001.dcm
#    掩膜文件：  {case_id}mask.seg.nrrd     示例：001mask.seg.nrrd  ← 与原版一致
#
image_files = sorted(BASE_DIR.glob("*.dcm"))

records = []
for img_path in tqdm(image_files):
    case_id   = img_path.stem                                   # e.g. "001"
    mask_path = BASE_DIR / f"{case_id}mask.seg.nrrd"           # 💡 掩膜仍为 nrrd

    if not mask_path.exists():
        print(f"⚠️  找不到掩膜：{mask_path.name}，跳过")
        continue

    try:
        gray, mask       = load_dicom_and_nrrd_mask(img_path, mask_path)  # 💡 修改点
        ith_val, cluster_map = compute_ith_score(gray, mask)
        records.append({
            '病例名称': case_id,
            'ITH评分':  round(ith_val, 6),
            'ROI面积':  int(mask.sum()),
        })
        save_nejm_figure(gray, mask, cluster_map, ith_val, case_id, FIGURE_DIR)
    except Exception as e:
        print(f"❌ {case_id} 失败: {e}")

if records:
    pd.DataFrame(records).to_csv(OUTPUT_CSV, index=False, encoding='utf-8-sig')
    print(f"\n🎉 处理完成！结果已保存至：{OUTPUT_CSV}")
